{
  "manifest_version": 3,
  "name": "Draftwise — private writing assistant",
  "version": "0.2.0",
  "description": "Local-first writing checks and optional BYOK suggestions inside text fields.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Draftwise",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": []
}
